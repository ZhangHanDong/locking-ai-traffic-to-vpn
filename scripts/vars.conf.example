# Copy to vars.conf and fill in. All scripts source this file.

# WireGuard config managed by wg-quick, and its interface name after "up"
WG_CONF="$HOME/wg0.conf"
IFACE="utun8"

# Peer public key from the [Peer] section of WG_CONF
PEER_PUBKEY="REPLACE_ME"

# Tunnel DNS (must be reachable only via the tunnel; appears in AllowedIPs)
TUNNEL_DNS="10.100.0.1"

# Static dedicated ranges (Anthropic). Add more CIDRs space-separated.
STATIC_CIDRS="160.79.104.0/21 2607:6bc0::/48"

# Anycast-domain services (OpenAI et al): pinned as /32, kept fresh by the sync daemon.
# The OpenAI list is the full host surface extracted from
# ChatGPT.app/Contents/Resources/app.asar — pin EVERY subdomain; apex != subdomain
# on Cloudflare (chatgpt.site != assets.chatgpt.site). codex-cloud-*.chatgpt.com =
# agent "dot" cloud backends; realtime.* = voice; *.oaiusercontent.com = files/agent
# sandbox; chatgpt.site/chatgpt-team.site are in the app's scoped-UA host list.
DOMAINS="api.anthropic.com claude.ai platform.claude.com api.openai.com chatgpt.com www.chatgpt.com api.chatgpt.com realtime.chatgpt.com codex-cloud-backend.chatgpt.com codex-cloud-environments.chatgpt.com learn.chatgpt.com m.chatgpt.com gov.chatgpt.com ab.chatgpt.com ws.chatgpt.com auth.openai.com auth0.openai.com platform.openai.com admin.openai.com cdn.openai.com files.openai.com images.openai.com bzrcdn.openai.com statsigcdn.openai.com multiplayer-u0.api.openai.com pay.openai.com developers.openai.com help.openai.com model-spec.openai.com status.openai.com ads.openai.com connect.ads.openai.com chat.openai.com ios.chat.openai.com apps.openai.com oaistatic.com auth-cdn.oaistatic.com cdn.oaistatic.com persistent.oaistatic.com updates.oaistatic.com files.oaiusercontent.com web-sandbox.oaiusercontent.com chat.com chatgpt.site assets.chatgpt.site chatgpt-team.site"

# Sync daemon interval (seconds). Hourly shrinks the anycast-rotation window; 60 = tightest.
SYNC_INTERVAL=3600

# --- Optional: endpoint watchdog (commercial relays that rotate entry IPs) ---
# Set to the Endpoint host/IP from WG_CONF. Script re-resolves it and wg-sets when stale.
ENDPOINT_HOST=""
ENDPOINT_PORT=""
